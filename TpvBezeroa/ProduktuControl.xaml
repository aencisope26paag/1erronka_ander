<UserControl x:Class="TpvBezeroa.ProduktuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Height="150">
    <Border x:Name="Txartela" BorderThickness="2" BorderBrush="SaddleBrown"
            Background="Cornsilk" CornerRadius="6" Margin="4" Padding="4">
        <StackPanel VerticalAlignment="Center">
            <Grid Height="60">
                <Image x:Name="IrudiaIrudia" Stretch="Uniform" />
                <TextBlock x:Name="IrudiaOrdezkoa" Text="🍽" FontSize="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="IzenaTestua" FontWeight="Bold" Margin="0,4,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="PrezioaTestua" TextAlignment="Center" Margin="0,2,0,0" />
            <TextBlock x:Name="StockaTestua" TextAlignment="Center"
                       FontSize="11" Foreground="DimGray" />
        </StackPanel>
    </Border>
</UserControl>