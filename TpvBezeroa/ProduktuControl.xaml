<UserControl x:Class="TpvBezeroa.ProduktuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Height="95">
    <Border x:Name="Txartela" BorderThickness="2" BorderBrush="SaddleBrown"
            Background="Cornsilk" CornerRadius="6" Margin="4" Padding="4">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="IzenaTestua" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock x:Name="PrezioaTestua" TextAlignment="Center" Margin="0,4,0,0" />
            <TextBlock x:Name="StockaTestua" TextAlignment="Center"
                       FontSize="11" Foreground="DimGray" />
        </StackPanel>
    </Border>
</UserControl>