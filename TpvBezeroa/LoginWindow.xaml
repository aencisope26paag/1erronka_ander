<Window x:Class="TpvBezeroa.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="270" Width="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Erabiltzailea:" />
        <TextBox x:Name="IzenaTextBox" Margin="0,2,0,10" />
        <TextBlock Text="Pasahitza:" />
        <PasswordBox x:Name="PasahitzaBox" Margin="0,2,0,10" />
        <Button Content="Sartu" Click="Sartu_Click" IsDefault="True" Padding="10,4" />
        <TextBlock x:Name="ErroreaTextBlock" Foreground="Crimson" Margin="0,10,0,0" />
    </StackPanel>
</Window>