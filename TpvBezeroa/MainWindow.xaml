<Window x:Class="TpvBezeroa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TPV" Height="350" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="KaixoTextBlock" FontSize="18" FontWeight="Bold" />

        <WrapPanel Grid.Row="1" Margin="0,20,0,0">
            <Button x:Name="TpvButton" Content="Kontsumoak (TPV)" Click="Tpv_Click"
                    Width="160" Height="60" Margin="0,0,10,10" />
            <Button x:Name="ErreserbakButton" Content="Mahai-erreserbak" Click="Erreserbak_Click"
                    Width="160" Height="60" Margin="0,0,10,10" />
            <Button x:Name="ErabiltzaileakButton" Content="Erabiltzaileak" Click="Erabiltzaileak_Click"
                    Width="160" Height="60" Margin="0,0,10,10" />
            <Button x:Name="StockaButton" Content="Stocka" Click="Stocka_Click"
                    Width="160" Height="60" Margin="0,0,10,10" />
        </WrapPanel>
    </Grid>
</Window>