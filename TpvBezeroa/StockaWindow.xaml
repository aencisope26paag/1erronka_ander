<Window x:Class="TpvBezeroa.StockaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biltegiko stocka" Height="580" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="Taula" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" Margin="0,0,12,0"
                  SelectionChanged="Taula_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produktua" Binding="{Binding Izena}" Width="*" />
                <DataGridTextColumn Header="Kategoria" Binding="{Binding Kategoria}" Width="*" />
                <DataGridTextColumn Header="Prezioa" Binding="{Binding Prezioa, StringFormat={}{0:0.00} €}" />
                <DataGridTextColumn Header="Stocka" Binding="{Binding Stocka}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Produktua:" />
            <TextBox x:Name="IzenaBox" Margin="0,2,0,8" />
            <TextBlock Text="Kategoria:" />
            <TextBox x:Name="KategoriaBox" Margin="0,2,0,8" />
            <TextBlock Text="Prezioa (adib. 2,50):" />
            <TextBox x:Name="PrezioaBox" Margin="0,2,0,8" />
            <TextBlock Text="Stocka:" />
            <TextBox x:Name="StockaBox" Margin="0,2,0,8" />
            <TextBlock Text="Irudia:" />
            <Border BorderBrush="Gray" BorderThickness="1" Height="80" Margin="0,2,0,4">
                <Image x:Name="IrudiaAurrebista" Stretch="Uniform" />
            </Border>
            <Button Content="Irudia aukeratu..." Click="Irudia_Click" Padding="6" Margin="0,0,0,12" />

            <Button Content="Berria" Click="Berria_Click" Padding="6" Margin="0,0,0,6" />
            <Button Content="Gorde" Click="Gorde_Click" Padding="6" Margin="0,0,0,6" />
            <Button x:Name="EzabatuButton" Content="Ezabatu" Click="Ezabatu_Click" Padding="6" />

            <TextBlock x:Name="MezuaTextBlock" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Window>