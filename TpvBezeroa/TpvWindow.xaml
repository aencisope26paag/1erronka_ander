<Window x:Class="TpvBezeroa.TpvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kontsumoak (TPV)" Height="560" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Productos -->
        <GroupBox Header="Produktuak" Margin="0,0,10,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="ProduktuPanela" />
            </ScrollViewer>
        </GroupBox>

        <!-- Ticket -->
        <GroupBox Grid.Column="1" Header="Tiketa">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="TiketaGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produktua" Binding="{Binding Izena}" Width="*" />
                        <DataGridTextColumn Header="Kop." Binding="{Binding Kantitatea}" />
                        <DataGridTextColumn Header="Prezioa" Binding="{Binding Prezioa, StringFormat={}{0:0.00} €}" />
                        <DataGridTextColumn Header="Guztira" Binding="{Binding Guztira, StringFormat={}{0:0.00} €}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="GuztiraTextBlock" Grid.Row="1" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Right" Margin="0,8" Text="Guztira: 0,00 €" />

                <StackPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="- 1" Click="Gutxitu_Click" Padding="12,4" Margin="0,0,6,0" />
                        <Button Content="Garbitu" Click="Garbitu_Click" Padding="12,4" />
                    </StackPanel>
                    <Button Content="Erosketa osatu" Click="Osatu_Click" Padding="8" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>